# Copie para .env e ajuste os valores:  cp .env.example .env
# Nunca versione o arquivo .env.

# ---- Aplicação ----
APP_ENV=development          # development | test | production
APP_VERSION=dev

# ---- PostgreSQL ----
POSTGRES_USER=workevent
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=workevent
POSTGRES_PORT=5432           # porta exposta em 127.0.0.1
DB_SSLMODE=disable           # em produção use require/verify-full

# ---- API ----
BACKEND_PORT=8080
LOG_LEVEL=info               # debug | info | warn | error
LOG_FORMAT=json              # json | text
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
SWAGGER_ENABLED=true

# ---- Frontend ----
FRONTEND_PORT=8000

# ---- Observabilidade (docker compose --profile observability) ----
OTEL_TRACING_ENABLED=false   # true para enviar traces ao Jaeger
OTEL_SAMPLE_RATIO=1.0        # em produção, algo como 0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
JAEGER_UI_PORT=16686
